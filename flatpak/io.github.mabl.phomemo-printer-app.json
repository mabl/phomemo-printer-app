{
  "app-id": "io.github.mabl.phomemo-printer-app",
  "branch": "experimental",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "phomemo-launcher",
  "finish-args": [
    "--allow=bluetooth",
    "--system-talk-name=org.bluez",
    "--share=network",
    "--system-talk-name=org.freedesktop.Avahi"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {"CARGO_NET_OFFLINE": "true"}
  },
  "cleanup": ["/include", "/lib/pkgconfig", "/lib/*.a", "/lib/*.la", "/share/man"],
  "modules": [
    {
      "name": "avahi-client",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --libdir=/app/lib --disable-static --disable-glib --disable-gobject --disable-introspection --disable-qt3 --disable-qt4 --disable-qt5 --disable-gtk --disable-gtk3 --disable-python --disable-mono --disable-monodoc --disable-autoipd --disable-libdaemon --disable-libevent --disable-gdbm --disable-manpages --with-xml=none --with-distro=none --with-systemdsystemunitdir=no",
        "make -C avahi-common -j${FLATPAK_BUILDER_N_JOBS}",
        "make -C avahi-client -j${FLATPAK_BUILDER_N_JOBS}",
        "make -C avahi-common install",
        "make -C avahi-client install",
        "make avahi-client.pc",
        "install -Dm644 avahi-client.pc /app/lib/pkgconfig/avahi-client.pc",
        "install -Dm644 LICENSE /app/share/licenses/avahi-client/LICENSE"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://github.com/avahi/avahi/releases/download/v0.8/avahi-0.8.tar.gz",
        "sha256": "060309d7a333d38d951bc27598c677af1796934dbd98e1024e7ad8de798fedda"
      }]
    },
    {
      "name": "libcups",
      "buildsystem": "autotools",
      "config-opts": [
        "--libdir=/app/lib", "--with-components=libcups", "--disable-static", "--disable-libusb",
        "--disable-dbus", "--disable-pam", "--disable-systemd", "--disable-gssapi",
        "--with-tls=gnutls", "--with-dnssd=avahi"
      ],
      "post-install": ["install -Dm644 LICENSE /app/share/licenses/libcups/LICENSE"],
      "sources": [{
        "type": "archive",
        "url": "https://github.com/OpenPrinting/cups/releases/download/v2.4.12/cups-2.4.12-source.tar.gz",
        "sha256": "b1dde191a4ae2760c47220c82ca6155a28c382701e6c1a0159d1054990231d59"
      }]
    },
    {
      "name": "pappl1",
      "buildsystem": "autotools",
      "config-opts": [
        "--libdir=/app/lib", "--enable-shared", "--disable-static", "--disable-libpam", "--disable-libusb",
        "--enable-libjpeg", "--enable-libpng", "--with-tls=gnutls", "--with-dnssd=avahi"
      ],
      "make-args": ["-C", "pappl"],
      "make-install-args": ["-C", "pappl"],
      "post-install": ["install -Dm644 LICENSE /app/share/licenses/pappl/LICENSE"],
      "sources": [{
        "type": "archive",
        "url": "https://github.com/michaelrsweet/pappl/releases/download/v1.4.12/pappl-1.4.12.tar.gz",
        "sha256": "1684c4e06446e9f7d93a39729fa0ba56f07a4007560080fdad7d0e2076a3615f"
      }]
    },
    {
      "name": "cbindgen",
      "buildsystem": "simple",
      "build-options": {"env": {"CARGO_HOME": "/run/build/cbindgen/cargo"}},
      "build-commands": ["cargo build --release --frozen", "install -Dm755 target/release/cbindgen /app/bin/cbindgen"],
      "cleanup": ["/bin/cbindgen"],
      "sources": [
        {
          "type": "archive",
          "archive-type": "tar-gzip",
          "url": "https://static.crates.io/crates/cbindgen/cbindgen-0.29.2.crate",
          "sha256": "befbfd072a8e81c02f8c507aefce431fe5e7d051f83d48a23ffc9b9fe5a11799"
        },
        "cbindgen-sources.json"
      ]
    },
    {
      "name": "dbus-test-daemon",
      "buildsystem": "simple",
      "build-commands": [
        "meson setup _build --prefix=/app -Ddefault_library=static -Dmessage_bus=true -Dtools=false -Dmodular_tests=disabled -Dinstalled_tests=false -Dtraditional_activation=false -Dsystemd=disabled -Duser_session=false -Dapparmor=disabled -Dselinux=disabled -Dlibaudit=disabled -Dx11_autolaunch=disabled -Ddoxygen_docs=disabled -Dducktype_docs=disabled -Dxml_docs=disabled -Dqt_help=disabled",
        "ninja -C _build bus/dbus-daemon",
        "install -Dm755 _build/bus/dbus-daemon /app/libexec/flatpak-tests/dbus-daemon"
      ],
      "cleanup": ["/libexec/flatpak-tests"],
      "sources": [{
        "type": "archive",
        "url": "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz",
        "sha256": "0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2"
      }]
    },
    {
      "name": "phomemo-printer-app",
      "buildsystem": "simple",
      "build-options": {"env": {"CARGO_HOME": "/run/build/phomemo-printer-app/cargo"}},
      "build-commands": [
        "python3 flatpak/update-sources.py --check",
        "install -Dm755 flatpak/cargo-offline /run/build/phomemo-printer-app/cargo-offline",
        "make -j${FLATPAK_BUILDER_N_JOBS} CARGO=/run/build/phomemo-printer-app/cargo-offline PREFIX=/app",
        "cc -std=c17 -O2 -Wall -Wextra -Werror flatpak/launcher.c -o phomemo-launcher $(pkg-config --cflags --libs gio-2.0 cups)",
        "install -Dm755 phomemo-printer-app /app/libexec/phomemo-printer-app",
        "install -Dm755 phomemo-launcher /app/bin/phomemo-launcher",
        "install -Dm755 flatpak/phomemo-printer-app /app/bin/phomemo-printer-app",
        "install -Dm644 flatpak/io.github.mabl.phomemo-printer-app.desktop /app/share/applications/io.github.mabl.phomemo-printer-app.desktop",
        "install -Dm644 flatpak/io.github.mabl.phomemo-printer-app.svg /app/share/icons/hicolor/scalable/apps/io.github.mabl.phomemo-printer-app.svg",
        "install -Dm644 flatpak/io.github.mabl.phomemo-printer-app.metainfo.xml /app/share/metainfo/io.github.mabl.phomemo-printer-app.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/phomemo-printer-app/LICENSE"
      ],
      "run-tests": true,
      "test-commands": [
        "python3 flatpak/test-sources.py",
        "python3 flatpak/test-linkage.py --binary /app/libexec/phomemo-printer-app",
        "python3 scripts/test_packaged_runtime.py --binary /app/libexec/phomemo-printer-app",
        "python3 flatpak/test-launcher.py --launcher /app/bin/phomemo-launcher --binary /app/libexec/phomemo-printer-app --dbus-daemon /app/libexec/flatpak-tests/dbus-daemon"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [".git", ".flatpak-builder", "target", "result", "build-flatpak", "flatpak-repo", "phomemo-printer-app", "generated", "cargo", "Archive.zip"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
