# Local-first defaults
# PHOMEMO_SERVER_PORT=8000
PHOMEMO_LISTEN_HOSTNAME=localhost

# Optional auth/admin controls
# PHOMEMO_AUTH_SERVICE=cups
# PHOMEMO_ADMIN_GROUP=lpadmin

