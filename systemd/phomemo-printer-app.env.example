# Settings for phomemo-printer-app.service; `phomemo-printer-app --help`
# lists them. Each commented line shows the value used when it is unset; an
# empty value restores the application's own default. Restart the service
# after editing: systemctl restart phomemo-printer-app

# Port of the web interface and IPP, set by the unit; 0 lets PAPPL search
# for a free one. register-cups needs a fixed one.
#PHOMEMO_SERVER_PORT=8000

# localhost serves this host only. A host name, an address ([...] for IPv6),
# or * for every address also serves the network, where the web interface
# asks for a login.
#PHOMEMO_LISTEN_HOSTNAME=localhost

# The PAM service logins are checked with: none for localhost, "cups"
# otherwise. Its pam_unix checks other users' passwords only for a root
# server: for remote logins, install the drop-in root.conf, from the
# application's data directory (https://github.com/mabl/phomemo-printer-app).
#PHOMEMO_AUTH_SERVICE=

# The group a login must belong to; unset, any user who logs in.
#PHOMEMO_ADMIN_GROUP=

# "-" (standard error) and "syslog" log to the journal. A file must be below
# /var/lib/phomemo-printer-app: the service may write nowhere else but its
# runtime directory and its private /tmp, /var/tmp and /dev/shm.
#PHOMEMO_LOG_FILE=-
#PHOMEMO_LOG_LEVEL=info

# Set by the unit, in its state directory; moved, they must stay below it.
# Empty, the spool goes to a temporary directory, and PAPPL chooses the state
# file: below the service's HOME, the state directory, for the dynamic user,
# but /var/lib/phomemo-printer-app.state, which it cannot write, for root.
#PHOMEMO_STATE_FILE=/var/lib/phomemo-printer-app/phomemo-printer-app.state
#PHOMEMO_SPOOL_DIRECTORY=/var/lib/phomemo-printer-app/spool

# Refuse connections without TLS. The server makes itself a certificate,
# kept in the state directory.
#PHOMEMO_TLS_ONLY=0

# RFCOMM channels to try, comma-separated; a device URI can name one with
# ?channel=N.
#PHOMEMO_BT_CHANNELS=1
